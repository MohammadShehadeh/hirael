    "@shadcn/lint": "^0.2.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/babel__core": "^7.20.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
