  "scripts": {
    "dev": "next dev",
    "build": "pnpm registry:gen && pnpm registry:props && pnpm check:registry && pnpm registry:build && next build",
    "start": "npx serve out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "registry:gen": "tsx scripts/build-registry.mts && tsx scripts/build-llms.mts",
    "registry:props": "tsx scripts/extract-props.mts",
    "registry:build": "shadcn build && tsx scripts/stamp-source.mts",
    "check:registry": "tsx scripts/check-registry.mts",
    "check:install": "tsx scripts/check-install.mts",
    "prepare": "husky && pnpm registry:gen && pnpm registry:props"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
