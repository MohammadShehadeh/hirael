{
  "name": "hirael",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Mohammad Shehadeh",
    "url": "https://hirael.com"
  },
  "homepage": "https://hirael.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/MohammadShehadeh/hirael"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm registry:gen && pnpm registry:props && pnpm check:registry && pnpm registry:build && pnpm registry:md && next build",
    "start": "npx serve out",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "registry:gen": "tsx scripts/build-registry.mts && tsx scripts/build-llms.mts",
    "registry:props": "tsx scripts/extract-props.mts",
    "registry:md": "tsx scripts/build-markdown.mts",
    "registry:build": "shadcn build && shadcn build registry.base.json -o public/r/base && tsx scripts/stamp-source.mts",
    "check:registry": "tsx scripts/check-registry.mts",
    "check:install": "tsx scripts/check-install.mts",
    "prepare": "husky && pnpm registry:gen && pnpm registry:props && pnpm registry:md"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-table": "^9.2.4",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "embla-carousel-react": "^8.6.0",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.45.0",
    "motion": "^13.2.0",
    "next": "16.3.5",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.87.0",
    "react-resizable-panels": "^4.12.4",
    "recharts": "3.10.1",
    "shadcn": "^4.21.0",
    "shaders": "^3.2.470",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.4.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.17",
      "@types/react-dom": "19.2.3",
      "postcss": ">=8.5.10"
    }
  }
}
