    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
