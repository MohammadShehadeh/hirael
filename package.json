{
  "name": "hirael",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Mohammad Shehadeh",
    "url": "https://hirael.com"
  },
  "homepage": "https://hirael.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/MohammadShehadeh/hirael"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm registry:gen && pnpm registry:props && pnpm check:registry && pnpm registry:build && pnpm registry:md && next build",
    "start": "npx serve out",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "registry:gen": "tsx scripts/build-registry.mts && tsx scripts/build-llms.mts",
    "registry:props": "tsx scripts/extract-props.mts",
    "registry:md": "tsx scripts/build-markdown.mts",
    "registry:build": "shadcn build && shadcn build registry.base.json -o public/r/base && tsx scripts/stamp-source.mts",
    "check:registry": "tsx scripts/check-registry.mts",
    "check:install": "tsx scripts/check-install.mts",
    "check:health": "tsx scripts/check-health.mts",
    "prepare": "husky && pnpm registry:gen && pnpm registry:props && pnpm registry:md",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "lint-staged": {
    "**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": "eslint --fix --no-warn-ignored",
    "**/*": "prettier --write --ignore-unknown"
  },
  "dependencies": {
