    "lucide-react": "^1.18.0",
    "motion": "^12.40.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.9",
    "radix-ui": "^1.5.0",
    "react": "19.2.7",
